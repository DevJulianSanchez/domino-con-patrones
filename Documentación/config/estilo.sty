% =====================================================================
% estilo.sty : formato formal del documento de diseño (UAN)
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/estilo}[2026/10/01 Estilo formal documento de diseño]

% ---------- Idioma ----------------------------------------------------
\RequirePackage{fontspec}
\IfFileExists{spanish.ldf}
  {\RequirePackage[spanish,es-noshorthands,es-tabla]{babel}}
  {\RequirePackage{babel}\babelprovide[import,main]{spanish}}
\RequirePackage{csquotes}
\AtBeginDocument{%
  \renewcommand{\tablename}{Tabla}%
  \renewcommand{\listtablename}{Índice de tablas}%
  \renewcommand{\contentsname}{Índice general}}

% ---------- Tipografía: TeX Gyre Pagella (incluida en TeX Live) ---------
\setmainfont{texgyrepagella}[
  Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic, Ligatures=TeX]
\setsansfont{texgyreheros}[
  Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic, Scale=0.92]
\setmonofont{lmmono10}[Extension=.otf, UprightFont=*-regular, ItalicFont=lmmonoslant10-regular, Scale=0.95]
\RequirePackage{microtype}

% ---------- Página ----------------------------------------------------
\RequirePackage[letterpaper,top=3cm,bottom=2.5cm,left=3cm,right=2.5cm,
  headheight=15pt,headsep=1cm,footskip=1.2cm]{geometry}
\RequirePackage{setspace}
\setstretch{1.4}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0.35em}
\setlength{\emergencystretch}{3em}
\widowpenalty=10000 \clubpenalty=10000

% ---------- Colores institucionales (uso sobrio) ----------------------
\RequirePackage[table]{xcolor}
\definecolor{uanazul}{HTML}{1F1F41}      % azul oscuro del logotipo
\definecolor{uanazulmedio}{HTML}{0B589C} % azul de la palabra Universidad
\definecolor{uanoro}{HTML}{E5B227}
\definecolor{gristexto}{HTML}{4A4A4A}
\definecolor{grisregla}{HTML}{B5B5B5}
\definecolor{grisfondo}{HTML}{F4F4F4}

% ---------- Títulos ---------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{uanazul}}{\thesection.}{0.7em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{uanazul}}{\thesubsection.}{0.7em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\itshape\color{uanazul}}{\thesubsubsection.}{0.7em}{}
\titlespacing*{\section}{0pt}{2.2em}{1em}
% Evita títulos huérfanos al pie de página
\RequirePackage{etoolbox}
\pretocmd{\section}{\needspace{14\baselineskip}}{}{}
\pretocmd{\subsection}{\needspace{4\baselineskip}}{}{}
\titlespacing*{\subsection}{0pt}{1.6em}{0.6em}
\titlespacing*{\subsubsection}{0pt}{1.2em}{0.4em}

% ---------- Índices ---------------------------------------------------
\RequirePackage{tocloft}
\renewcommand{\cfttoctitlefont}{\normalfont\Large\bfseries\color{uanazul}}
\renewcommand{\cftlottitlefont}{\normalfont\Large\bfseries\color{uanazul}}
\renewcommand{\cftsecfont}{\bfseries}
\renewcommand{\cftsecpagefont}{\bfseries}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\setlength{\cftbeforesecskip}{0.55em}

% ---------- Encabezado y pie ------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\scshape\color{gristexto}\Universidad}
\fancyhead[R]{\footnotesize\itshape\color{gristexto}\Proyecto. \TituloDoc}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{{\color{grisregla}\hrule height\headrulewidth}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}}

% ---------- Tablas ----------------------------------------------------
\RequirePackage{array,tabularx,longtable,booktabs,multirow}
\renewcommand{\arraystretch}{1.3}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\setlength{\heavyrulewidth}{0.9pt}
\setlength{\lightrulewidth}{0.4pt}
\newcommand{\cab}[1]{\textsc{\bfseries #1}}
\newcommand{\filasep}{\arrayrulecolor{grisregla}\midrule\arrayrulecolor{black}}
% Entorno de tabla con texto compacto
\newcommand{\tablacompacta}{\small\setstretch{1.15}}

% ---------- Leyendas (estilo APA: número en negrita, título en cursiva) -----
\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf,textfont=it,labelsep=newline,
  justification=raggedright,singlelinecheck=false,skip=6pt}
\captionsetup[table]{position=top}

% ---------- Listas, figuras, referencias ------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=0.15em,topsep=0.3em,leftmargin=1.6em}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{needspace}
\RequirePackage[round,authoryear]{natbib}
\setlength{\bibsep}{0.5em}
\setlength{\bibhang}{1.25cm}
\RequirePackage[hidelinks]{hyperref}
% Convención: cita en línea en negrita (autor, año)
\newcommand{\citar}[1]{\textbf{\citep{#1}}}
\newcommand{\citarp}[2]{\textbf{\citep[#2]{#1}}}

% ---------- Recuadros --------------------------------------------------
\RequirePackage[most]{tcolorbox}
% Sección en elaboración: visible para no entregarla por error
\newtcolorbox{pendiente}{enhanced,colback=white,colframe=grisregla,
  boxrule=0.5pt,arc=0pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
  fontupper=\small\itshape\color{gristexto},
  borderline west={2.5pt}{0pt}{uanoro}}
% Nota o restricción destacada
\newtcolorbox{nota}{enhanced,colback=grisfondo,colframe=grisfondo,
  boxrule=0pt,arc=0pt,left=12pt,right=10pt,top=7pt,bottom=7pt,
  fontupper=\small,borderline west={2pt}{0pt}{uanazul}}

% ---------- Diagramas draw.io ---------------------------------------------
% \diagrama[ancho]{nombre}{título}{etiqueta}   figura en la página actual
% \diagrama*{nombre}{título}{etiqueta}         figura en página apaisada
% Incluye diagramas/exportados/<nombre>.pdf, que .latexmkrc genera a partir de
% diagramas/<nombre>.drawio. Consultar el .drawio lo registra como dependencia
% (-recorder), de modo que guardarlo en VS Code dispara la recompilación.
\RequirePackage{pdflscape}
\newcommand{\diagramafigura}[5][0.75]{% [fracción de alto]{ancho}{nombre}{título}{etiqueta}
  \IfFileExists{diagramas/exportados/#3.pdf}
    {\begin{figure}[H]
       \caption{#4}\label{#5}
       \centering
       \includegraphics[width=#2,height=#1\textheight,keepaspectratio]%
         {diagramas/exportados/#3.pdf}
     \end{figure}}
    {\begin{pendiente}
       Diagrama sin exportar: \texttt{diagramas/\detokenize{#3}.drawio}.
       Compilar con \texttt{latexmk} para generar
       \texttt{diagramas/exportados/\detokenize{#3}.pdf}.
     \end{pendiente}}}
\NewDocumentCommand{\diagrama}{s O{\textwidth} m m m}{%
  \IfFileExists{diagramas/#3.drawio}{}{}%
  \IfBooleanTF{#1}
    {\begin{landscape}\diagramafigura[0.82]{\linewidth}{#3}{#4}{#5}\end{landscape}}
    {\diagramafigura{#2}{#3}{#4}{#5}}}

% ---------- Plantilla de caso de uso -------------------------------------
\newcommand{\et}[1]{\textsc{\bfseries #1}}
\newcommand{\cubloque}[1]{\par\needspace{5\baselineskip}\medskip\noindent
  {\normalfont\bfseries\color{uanazul}#1}\par\nopagebreak\smallskip}

% \encabezadoCU{nombre}{código}{actores}{tipo}{requisitos}{relacionados}
%              {precondición}{postcondición}{autor}{fecha}{versión}
\newcommand{\encabezadoCU}[9]{%
  \def\cuNombre{#1}\def\cuCodigo{#2}\def\cuActores{#3}\def\cuTipo{#4}%
  \def\cuReq{#5}\def\cuRel{#6}\def\cuPre{#7}\def\cuPost{#8}\def\cuAutor{#9}%
  \encabezadoCUcont}
\newcommand{\encabezadoCUcont}[2]{%
  {\tablacompacta\noindent
  \begin{tabularx}{\textwidth}{@{}L{3.3cm}Y@{}}
    \toprule
    \et{Caso de uso} & \textbf{\cuCodigo.\enspace\cuNombre} \\ \filasep
    \et{Actores} & \cuActores \\ \filasep
    \et{Tipo} & \cuTipo \\ \filasep
    \et{Requisitos} & \cuReq \\ \filasep
    \et{Casos relacionados} & \cuRel \\ \filasep
    \et{Precondición} & \cuPre \\ \filasep
    \et{Postcondición} & \cuPost \\ \filasep
    \et{Autor} & \cuAutor \\ \filasep
    \et{Fecha y versión} & #1\enspace·\enspace versión #2 \\
    \bottomrule
  \end{tabularx}\par}}

% Bloque de texto con título (Propósito, Resumen, Comentarios)
\newcommand{\cajaCU}[1]{%
  {\tablacompacta\noindent
  \begin{tabularx}{\textwidth}{@{}Y@{}}
    \toprule #1 \\ \bottomrule
  \end{tabularx}\par}}

% Curso normal: cuatro columnas
\newenvironment{cursonormal}{%
  \par\tablacompacta\noindent
  \begin{longtable}{@{}C{0.75cm}L{6.15cm}C{0.75cm}L{6.15cm}@{}}
    \toprule
    \cab{Paso} & \cab{Acción del actor} & \cab{Paso} & \cab{Respuesta del sistema} \\
    \midrule \endhead
    \bottomrule \endlastfoot}
  {\end{longtable}\vspace{-1.6em}}
\newcommand{\paso}[4]{#1 & #2 & #3 & #4 \\}

% Cursos alternos: dos columnas
\newenvironment{cursosalternos}{%
  \par\tablacompacta\noindent
  \begin{longtable}{@{}C{1cm}L{13.4cm}@{}}
    \toprule
    \cab{Ref.} & \cab{Condición, acciones alternas y cierre} \\
    \midrule \endhead
    \bottomrule \endlastfoot}
  {\end{longtable}\vspace{-1.6em}}
\newcommand{\alterno}[2]{\textbf{#1} & #2 \\}

% Otros datos
\newcommand{\otrosdatosCU}[6]{%
  {\tablacompacta\noindent
  \begin{tabularx}{\textwidth}{@{}L{3cm}Y L{2.7cm}Y@{}}
    \toprule
    \et{Frecuencia} & #1 & \et{Rendimiento} & #2 \\ \filasep
    \et{Importancia} & #3 & \et{Urgencia} & #4 \\ \filasep
    \et{Estado} & #5 & \et{Estabilidad} & #6 \\
    \bottomrule
  \end{tabularx}\par}}

\endinput
