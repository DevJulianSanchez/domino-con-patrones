        <mxCell id="titulo_antes" value="Antes (Entrega 1): cada nivel de dificultad es una subclase de JugadorCpu" style="text;html=1;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#1F1F41;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="1156" height="24" as="geometry"/></mxCell>
