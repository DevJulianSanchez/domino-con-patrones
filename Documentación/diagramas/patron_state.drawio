        <mxCell id="titulo_despues" value="Después (Entrega 2): cada estado es un objeto que decide qué admite y a qué estado pasa" style="text;html=1;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#1F1F41;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="12" y="328" width="1156" height="24" as="geometry"/></mxCell>
