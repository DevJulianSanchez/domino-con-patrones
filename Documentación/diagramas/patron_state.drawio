        <mxCell id="titulo_antes" value="Antes (Entrega 1): Partida consulta la enumeración en cada operación" style="text;html=1;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#1F1F41;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="1156" height="24" as="geometry"/></mxCell>
        <mxCell id="PartidaA" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Partida&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:0px;margin-left:4px;"&gt;- estado : EstadoPartida&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:0px;margin-left:4px;"&gt;+ Iniciar() : void&lt;br&gt;+ JugarFicha(ficha : Ficha, extremo : Extremo) : void&lt;br&gt;+ Robar() : void&lt;br&gt;+ Pasar() : void&lt;br&gt;+ VerificarTiempo() : bool&lt;br&gt;+ DeshacerUltimaJugadaHumano() : void&lt;br&gt;+ OpcionesDe(jugador : Jugador) : IReadOnlyList&amp;lt;OpcionJugada&amp;gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#F4F6FA;strokeColor=#1F1F41;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="426" height="168" as="geometry"/></mxCell>
        <mxCell id="notaA" value="Iniciar():&lt;br&gt;  if (estado != EstadoPartida.Preparada) throw …&lt;br&gt;OpcionesDe(jugador):&lt;br&gt;  if (estado == EstadoPartida.Salida) return [fichaSalida]&lt;br&gt;  if (estado != EstadoPartida.EnCurso) return []&lt;br&gt;JugarFicha, Robar, Pasar, VerificarTiempo y Deshacer&lt;br&gt;repiten condiciones sobre el mismo atributo." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B59A3C;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="e01_notaA_PartidaA" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;endArrow=none;dashed=1;strokeColor=#B59A3C;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="notaA" target="PartidaA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
