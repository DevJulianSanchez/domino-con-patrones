        <mxCell id="notaA" value="Aplicar y Revertir modifican Mesa, Mano y&lt;br&gt;FichasParaRobar según el tipo:&lt;br&gt;switch (jugada.Tipo)&lt;br&gt;  ColocarFicha → mesa y mano&lt;br&gt;  Robar → fichas para robar y mano&lt;br&gt;  Pasar, TiempoAgotado → solo el turno" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B59A3C;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="300" height="110" as="geometry"/></mxCell>
