        <mxCell id="titulo_despues" value="Después (Entrega 2): cada jugada es un comando que se valida, se ejecuta y se deshace sobre sus receptores" style="text;html=1;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#1F1F41;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="12" y="378" width="1156" height="24" as="geometry"/></mxCell>
